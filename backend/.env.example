# 数据库
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/click_app

# Redis
REDIS_URL=redis://localhost:6379

# JWT（必须修改！可用命令生成：python -c "import secrets; print(secrets.token_urlsafe(48))"）
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRE_DAYS=7

# CORS 允许的前端域名（逗号分隔，留空则不允许跨域）
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 短信（需配置以下任一方式，否则无法发送验证码）
ALIYUN_ACCESS_KEY=
ALIYUN_ACCESS_SECRET=
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TEMPLATE=

# 邮箱验证码（配置后启用邮箱验证）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_email@qq.com

# 图片存储
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8000/uploads

# DeepSeek API（用于 AI 月刊生成）
DEEPSEEK_API_KEY=

# 开发模式（验证码固定为 123456，仅限本地开发，生产环境切勿开启）
DEV_MODE=false

# 调试模式（开启后暴露 /docs Swagger 文档，生产环境应关闭）
DEBUG_MODE=false
