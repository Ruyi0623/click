# 数据库密码
MYSQL_ROOT_PASSWORD=your_mysql_password

# JWT 密钥（务必修改！生成命令：python3 -c "import secrets; print(secrets.token_urlsafe(48))"）
JWT_SECRET=your-very-long-random-secret-key

# 应用访问地址
UPLOAD_BASE_URL=http://your-domain.com/uploads

# CORS 允许的前端域名（逗号分隔，如 https://your-app.com,http://localhost:5173）
CORS_ORIGINS=

# 调试模式（生产环境保持 false，开启后可访问 /docs Swagger 文档）
DEBUG_MODE=false

# 邮箱配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=your_email@qq.com

# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key

# 微信小程序（wx.login 必需）
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
